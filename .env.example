# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Sklik (Seznam) měřicí kód — retargeting + konverze přes c.seznam.cz/js/rc.js.
# Marketing-consent gated. Bez ID se kód neaktivuje (no-op).
# ID najdeš v Skliku: Nástroje → Měřicí kódy → Retargeting / Konverze (číslo za "id").
NEXT_PUBLIC_SKLIK_RTG_ID=
NEXT_PUBLIC_SKLIK_CONVERSION_ID=

# Meta Conversions API (server-side events: Purchase, InitiateCheckout)
# Reaches Meta even for cookie-declining / iOS visitors the browser Pixel misses.
# Token: Events Manager → Settings → Conversions API → Generate access token.
# Uses the pixel id from NEXT_PUBLIC_FB_PIXEL_ID above.
META_CAPI_ACCESS_TOKEN=
# Optional: paste the code from Events Manager → Test Events to verify wiring.
# Leave UNSET in production (test events don't count as real conversions).
META_TEST_EVENT_CODE=

# Email (Resend) — weeks.cz domain verified; From defaults to "Weeks <info@weeks.cz>"
RESEND_API_KEY=
RESEND_FROM=Weeks <info@weeks.cz>

# Fakturoid — daňový doklad po zaplacení (Client Credentials Flow, neplátce DPH)
FAKTUROID_SLUG=
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=
FAKTUROID_USER_AGENT=Weeks (admin@weeks.cz)

# Formspree (Waitlist)
NEXT_PUBLIC_FORMSPREE_ID=

# Discord Webhook (capacity notifications)
DISCORD_WEBHOOK_URL=

# Upstash Redis (state storage for cron)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron Secret
CRON_SECRET=

# Weeks Hub integration
WEEKS_HUB_API_URL=
WEEKS_HUB_API_KEY=

# Admin API token (gates /api/admin/refund — storno/refundace)
ADMIN_API_TOKEN=

# Sentry error monitoring (server-side; alerts on payment/registration failures)
# Leave unset in dev/preview — Sentry only activates in production with a DSN.
SENTRY_DSN=

# Comgate payment gateway (Karlovy Vary registration)
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true
COMGATE_METHOD=ALL
# Client-side hint to show the test-mode banner on /platba
NEXT_PUBLIC_COMGATE_TEST=true
